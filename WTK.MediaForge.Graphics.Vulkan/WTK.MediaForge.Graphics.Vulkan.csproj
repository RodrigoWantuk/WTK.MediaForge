<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ShaderCompilerGlobalOption_class_name>CompiledShaders</ShaderCompilerGlobalOption_class_name>
    <EnableDefaultShaderCompileItems>false</EnableDefaultShaderCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ShaderCompile Include="Shaders/**/*.vert" />
    <ShaderCompile Include="Shaders/**/*.frag" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="XenoAtom.ShaderCompiler.Build">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WTK.MediaForge.Graphics.Vulkan.Tests" />
    <InternalsVisibleTo Include="WTK.MediaForge.Windows" />
    <InternalsVisibleTo Include="WTK.MediaForge.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WTK.MediaForge.Composition\WTK.MediaForge.Composition.csproj" />
    <ProjectReference Include="..\WTK.MediaForge.Core\WTK.MediaForge.Core.csproj" />
    <ProjectReference Include="..\WTK.MediaForge.Diagnostics\WTK.MediaForge.Diagnostics.csproj" />
    <ProjectReference Include="..\WTK.MediaForge.Graphics.D3D11\WTK.MediaForge.Graphics.D3D11.csproj" />
  </ItemGroup>

</Project>
