<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
        xmlns:shell="using:WTK.MediaForge.Studio.Views.Shell"
        xmlns:dock="using:WTK.MediaForge.Studio.Views.Docking"
        xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
        xmlns:models="using:WTK.MediaForge.Studio.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="WTK.MediaForge.Studio.Views.MainWindow"
        x:DataType="vm:StudioShellViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Width="1440"
        Height="900"
        MinWidth="1280"
        MinHeight="720"
        Background="{StaticResource MfBackgroundBrush}"
        Title="WTK MediaForge Studio"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">

  <Grid Background="{StaticResource MfBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
      <RowDefinition Height="5" />
      <RowDefinition Height="240" MinHeight="180" MaxHeight="420" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>
    <shell:StudioTitleBarView Grid.Row="0" />
    <shell:StudioToolbarView Grid.Row="1" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="240" MaxWidth="420" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="360" MinWidth="320" MaxWidth="520" />
      </Grid.ColumnDefinitions>

      <dock:StudioDockPanelHost Grid.Column="0"
                                DataContext="{Binding NavigationDock}" />

      <GridSplitter Grid.Column="1"
                    Background="{StaticResource MfSurface2Brush}"
                    ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="44,*">
        <shell:PreviewHeaderView Grid.Row="0"
                                 DataContext="{Binding Preview}" />
        <shell:PreviewCanvasView Grid.Row="1"
                                 DataContext="{Binding Preview}" />
      </Grid>

      <GridSplitter Grid.Column="3"
                    Background="{StaticResource MfSurface2Brush}"
                    ResizeDirection="Columns" />

      <Grid Grid.Column="4" RowDefinitions="180,5,*">
        <dock:StudioDockPanelHost Grid.Row="0"
                                  DataContext="{Binding ProductionDock}" />
        <GridSplitter Grid.Row="1"
                      Background="{StaticResource MfSurface2Brush}"
                      ResizeDirection="Rows" />
        <dock:StudioDockPanelHost Grid.Row="2"
                                  DataContext="{Binding PropertiesDock}" />
      </Grid>
    </Grid>

    <GridSplitter Grid.Row="3"
                  Background="{StaticResource MfSurface2Brush}"
                  ResizeDirection="Rows" />

    <dock:StudioDockPanelHost Grid.Row="4"
                              DataContext="{Binding WorkbenchDock}" />
    <shell:StudioStatusBarView Grid.Row="5"
                               DataContext="{Binding StatusBar}" />

    <Border Grid.RowSpan="6"
            Background="#99000000"
            IsVisible="{Binding Dialog.IsOpen}">
      <Border Width="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="dialog-card">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
          <TextBlock Text="{Binding Dialog.Title}" Classes="title" FontSize="18" />
          <TextBlock Grid.Row="1"
                     Text="{Binding Dialog.Message}"
                     Classes="secondary"
                     TextWrapping="Wrap" />
          <Grid Grid.Row="2"
                ColumnDefinitions="130,*"
                ColumnSpacing="14"
                IsVisible="{Binding Dialog.IsSettingsDialog}">
            <StackPanel Spacing="6">
              <Border Classes="tab-pill selected">
                <TextBlock Text="Interface" Classes="secondary" />
              </Border>
              <Border Classes="tab-pill">
                <TextBlock Text="Idioma" Classes="secondary" />
              </Border>
              <Border Classes="tab-pill">
                <TextBlock Text="Avançado" Classes="secondary" />
              </Border>
            </StackPanel>
            <ScrollViewer Grid.Column="1" MaxHeight="360">
              <StackPanel Spacing="14">
                <Border Classes="section">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Painéis visíveis" Classes="panel-title" />
                    <CheckBox Content="Navegação" IsChecked="{Binding NavigationDock.IsVisible, Mode=TwoWay}" />
                    <CheckBox Content="Produção" IsChecked="{Binding ProductionDock.IsVisible, Mode=TwoWay}" />
                    <CheckBox Content="Propriedades" IsChecked="{Binding PropertiesDock.IsVisible, Mode=TwoWay}" />
                    <CheckBox Content="Camadas e saídas da cena" IsChecked="{Binding WorkbenchDock.IsVisible, Mode=TwoWay}" />
                    <CheckBox Content="Diagnóstico" IsChecked="False" IsEnabled="False" />
                    <CheckBox Content="Performance" IsChecked="False" IsEnabled="False" />
                    <CheckBox Content="Monitor de saídas" IsChecked="False" IsEnabled="False" />
                    <CheckBox Content="Mixer de áudio (futuro)" IsChecked="False" IsEnabled="False" />
                  </StackPanel>
                </Border>
                <Border Classes="section">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Layout" Classes="panel-title" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Restaurar layout padrão" Command="{Binding RestoreLayoutCommand}" />
                      <Button Content="Reencaixar todos os painéis" Command="{Binding RedockAllPanelsCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Classes="section">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Idioma da aplicação" Classes="panel-title" />
                    <TextBlock Text="Português (Brasil)" Classes="secondary" />
                    <TextBlock Text="English (US) estará disponível após reiniciar o Studio." Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <StackPanel Grid.Row="2" Spacing="10" IsVisible="{Binding Dialog.HasOptions}">
            <Border Classes="section" IsVisible="{Binding Dialog.IsRoutingDialog}">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,120" RowSpacing="8" ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="Transição" Classes="muted" />
                  <ComboBox ItemsSource="{Binding Dialog.TransitionOptions}"
                            SelectedValue="{Binding Dialog.SelectedTransitionId, Mode=TwoWay}"
                            SelectedValueBinding="{Binding Id}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:TransitionOptionViewModel">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Duração" Classes="muted" />
                  <NumericUpDown Value="{Binding Dialog.TransitionDurationMs, Mode=TwoWay}"
                                 Minimum="0"
                                 Maximum="5000"
                                 Increment="50" />
                </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="metric-card" IsVisible="{Binding Dialog.RequiresLiveConfirmation}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <components:StudioIcon Kind="{x:Static models:StudioIconKind.Warning}" IconSize="16" Foreground="{StaticResource MfWarningBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="Esta saída está ao vivo. Trocar a cena agora será visível na transmissão."
                               Classes="warning"
                               TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </Grid>
            </Border>
            <ScrollViewer MaxHeight="360">
              <ItemsControl ItemsSource="{Binding Dialog.Options}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StudioDialogOptionViewModel">
                    <Button Command="{Binding SelectCommand}"
                            IsEnabled="{Binding IsEnabled}"
                            Padding="0"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Stretch">
                      <Border Classes="scene-card" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                          <Border Classes="icon-box" Width="34" Height="34">
                            <components:StudioIcon Kind="{Binding IconKind}"
                                                   IconSize="18"
                                                   Foreground="{StaticResource MfAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge}" Classes="accent" FontSize="11" />
                          </Border>
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <StackPanel Grid.Row="3"
                      Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button Content="{Binding Dialog.SecondaryText}"
                    Command="{Binding CancelDialogCommand}" />
            <Button Content="{Binding Dialog.PrimaryText}"
                    Classes="primary"
                    Command="{Binding ConfirmDialogCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
