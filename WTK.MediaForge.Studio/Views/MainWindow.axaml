<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
        xmlns:shell="using:WTK.MediaForge.Studio.Views.Shell"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="WTK.MediaForge.Studio.Views.MainWindow"
        x:DataType="vm:StudioShellViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="740"
        Background="{StaticResource MfBackgroundBrush}"
        Title="WTK MediaForge Studio">

  <Grid Background="{StaticResource MfBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="5" />
      <RowDefinition Height="260" MinHeight="180" MaxHeight="420" />
      <RowDefinition Height="27" />
    </Grid.RowDefinitions>
    <shell:StudioTitleBarView Grid.Row="0" />
    <shell:StudioToolbarView Grid.Row="1" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="240" MaxWidth="420" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="340" MinWidth="300" MaxWidth="520" />
      </Grid.ColumnDefinitions>

      <shell:ProjectExplorerView Grid.Column="0"
                                 DataContext="{Binding ProjectExplorer}" />

      <GridSplitter Grid.Column="1"
                    Background="{StaticResource MfSurface2Brush}"
                    ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="44,*">
        <shell:PreviewHeaderView Grid.Row="0"
                                 DataContext="{Binding Preview}" />
        <shell:PreviewCanvasView Grid.Row="1"
                                 DataContext="{Binding Preview}" />
      </Grid>

      <GridSplitter Grid.Column="3"
                    Background="{StaticResource MfSurface2Brush}"
                    ResizeDirection="Columns" />

      <shell:InspectorView Grid.Column="4"
                           DataContext="{Binding Inspector}" />
    </Grid>

    <GridSplitter Grid.Row="3"
                  Background="{StaticResource MfSurface2Brush}"
                  ResizeDirection="Rows" />

    <shell:BottomWorkbenchView Grid.Row="4"
                               DataContext="{Binding BottomWorkbench}" />
    <shell:StudioStatusBarView Grid.Row="5"
                               DataContext="{Binding StatusBar}" />
  </Grid>
</Window>
