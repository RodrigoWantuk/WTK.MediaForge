<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:loc="using:WTK.MediaForge.Studio.Localization"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Shell.ProjectExplorerView"
             x:Name="ProjectExplorerRoot"
             x:DataType="vm:ProjectExplorerViewModel">
  <Border Classes="panel">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              BorderBrush="{StaticResource MfBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,10">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Loc Panel_ProjectExplorer}" Classes="panel-title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Padding="7" ToolTip.Tip="+ Cena" Command="{Binding AddSceneCommand}">
              <components:StudioIcon Kind="{x:Static models:StudioIconKind.Add}" IconSize="15" />
            </Button>
          </Grid>
          <TextBox Grid.Row="1"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Buscar cena..." />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="8,8,8,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectTreeGroupViewModel">
              <StackPanel Spacing="4" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,2,2">
                  <TextBlock Text="{Binding Title}" Classes="secondary" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="muted" />
                </Grid>
                <ListBox ItemsSource="{Binding VisibleItems}"
                         SelectedItem="{Binding #ProjectExplorerRoot.DataContext.SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectTreeItemViewModel">
                      <Border Classes="scene-card"
                              Classes.selected="{Binding IsSelected}"
                              Classes.active="{Binding IsActive}"
                              HorizontalAlignment="Stretch">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                          <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                            <Border Classes="icon-box" Width="30" Height="30">
                              <components:StudioIcon Kind="{Binding IconKind}"
                                                     IconSize="16"
                                                     Foreground="{StaticResource MfAccentBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Badge}" Classes="accent" FontSize="11" />
                            </Border>
                          </Grid>
                          <TextBlock Grid.Row="1" Text="{Binding Metadata}" Classes="secondary" />
                          <TextBlock Grid.Row="2" Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
