<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Shell.ProjectExplorerView"
             x:DataType="vm:ProjectExplorerViewModel">
  <Border Classes="panel">
    <Grid RowDefinitions="38,*">
      <Border Grid.Row="0"
              BorderBrush="{StaticResource MfBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,0">
        <TextBlock Text="Project Explorer" Classes="panel-title" VerticalAlignment="Center" />
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="8,8,8,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectTreeGroupViewModel">
              <StackPanel Spacing="4" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,2,2">
                  <TextBlock Text="{Binding Title}" Classes="secondary" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="muted" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectTreeItemViewModel">
                      <Button Classes="flat"
                              Command="{Binding SelectCommand}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Stretch">
                        <Border Classes="project-row"
                                Classes.selected="{Binding IsSelected}"
                                Classes.active="{Binding IsActive}"
                                HorizontalAlignment="Stretch">
                          <Grid ColumnDefinitions="14,32,*,Auto" RowDefinitions="Auto,Auto">
                            <Border Grid.RowSpan="2"
                                    Classes="health-dot"
                                    Classes.healthy="{Binding IsHealthy}"
                                    Classes.warning="{Binding IsWarning}"
                                    Classes.error="{Binding IsError}"
                                    Classes.planned="{Binding IsPlanned}"
                                    Classes.disabled="{Binding IsDisabled}"
                                    VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Grid.RowSpan="2"
                                    Width="24"
                                    Height="24"
                                    CornerRadius="5"
                                    Background="{StaticResource MfSurface3Brush}">
                              <TextBlock Text="{Binding Icon}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="9"
                                         FontWeight="SemiBold"
                                         Classes="secondary" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Metadata}" Classes="muted" FontSize="11" />
                            <Border Grid.Column="3" Grid.RowSpan="2" Classes="badge" IsVisible="{Binding HasBadge}">
                              <TextBlock Text="{Binding Badge}" Classes="accent" FontSize="10" />
                            </Border>
                          </Grid>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
