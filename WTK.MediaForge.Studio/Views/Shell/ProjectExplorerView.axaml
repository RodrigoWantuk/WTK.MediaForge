<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:loc="using:WTK.MediaForge.Studio.Localization"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Shell.ProjectExplorerView"
             x:Name="ProjectExplorerRoot"
             x:DataType="vm:ProjectExplorerViewModel">
  <Border Classes="panel">
    <Grid RowDefinitions="Auto,*,34">
      <Border Grid.Row="0"
              BorderBrush="{StaticResource MfBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,10">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{loc:Loc Panel_ProjectExplorer}" Classes="panel-title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="flat" Padding="6">
              <components:StudioIcon Kind="{x:Static models:StudioIconKind.Search}" IconSize="15" />
            </Button>
            <Button Grid.Column="2" Classes="flat" Padding="6">
              <components:StudioIcon Kind="{x:Static models:StudioIconKind.Menu}" IconSize="15" />
            </Button>
          </Grid>
          <TextBox Grid.Row="1"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="{loc:Loc Common_Search}" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="8,8,8,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectTreeGroupViewModel">
              <StackPanel Spacing="4" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,2,2">
                  <TextBlock Text="{Binding Title}" Classes="secondary" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="muted" />
                </Grid>
                <ListBox ItemsSource="{Binding VisibleItems}"
                         SelectedItem="{Binding #ProjectExplorerRoot.DataContext.SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectTreeItemViewModel">
                      <Border Classes="project-row"
                              Classes.selected="{Binding IsSelected}"
                              Classes.active="{Binding IsActive}"
                              HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="12,36,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" MinHeight="46">
                          <Border Grid.RowSpan="2"
                                  Classes="health-dot"
                                  Classes.healthy="{Binding IsHealthy}"
                                  Classes.warning="{Binding IsWarning}"
                                  Classes.error="{Binding IsError}"
                                  Classes.planned="{Binding IsPlanned}"
                                  Classes.disabled="{Binding IsDisabled}"
                                  VerticalAlignment="Center" />
                          <Border Grid.Column="1" Grid.RowSpan="2" Classes="icon-box">
                            <components:StudioIcon Kind="{Binding IconKind}"
                                                   IconSize="17"
                                                   Foreground="{StaticResource MfAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Metadata}" Classes="muted" FontSize="11" />
                          <Border Grid.Column="3" Grid.RowSpan="2" Classes="badge" IsVisible="{Binding HasBadge}">
                            <TextBlock Text="{Binding Badge}" Classes="accent" FontSize="10" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2"
              BorderBrush="{StaticResource MfBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="8,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <Button Classes="flat" Padding="6">
            <components:StudioIcon Kind="{x:Static models:StudioIconKind.Add}" IconSize="15" />
          </Button>
          <Button Grid.Column="1" Classes="flat" Padding="6">
            <components:StudioIcon Kind="{x:Static models:StudioIconKind.Open}" IconSize="15" />
          </Button>
          <Button Grid.Column="2" Classes="flat" Padding="6">
            <components:StudioIcon Kind="{x:Static models:StudioIconKind.Error}" IconSize="15" Foreground="{StaticResource MfTextMutedBrush}" />
          </Button>
          <TextBlock Grid.Column="4"
                     Text="{Binding VisibleItemCount, StringFormat='{}{0} itens'}"
                     Classes="muted"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
