<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             xmlns:a11y="using:Avalonia.Automation"
             x:Class="WTK.MediaForge.Studio.Views.Shell.ProjectExplorerView"
             x:DataType="vm:ProjectExplorerViewModel">
  <Border Classes="panel"
          a11y:AutomationProperties.AutomationId="project-explorer"
          a11y:AutomationProperties.Name="Navegação do projeto">
    <Grid RowDefinitions="Auto,Auto,*">
      <Border Grid.Row="0"
              BorderBrush="{StaticResource MfBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,8">
        <TextBlock Text="Navegação" Classes="panel-title" VerticalAlignment="Center" />
      </Border>

      <Grid Grid.Row="1"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8"
            Margin="10,8">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
          <Button Classes="flat"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static models:StudioExplorerTabKind.Scenes}"
                  TabIndex="10"
                  a11y:AutomationProperties.AutomationId="project-explorer.tab.scenes"
                  a11y:AutomationProperties.Name="Cenas">
            <Border Classes="tab-pill" Classes.selected="{Binding IsScenesTabSelected}">
              <TextBlock Text="Cenas" Classes="secondary" />
            </Border>
          </Button>
          <Button Grid.Column="1"
                  Classes="flat"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static models:StudioExplorerTabKind.Sources}"
                  TabIndex="11"
                  a11y:AutomationProperties.AutomationId="project-explorer.tab.sources"
                  a11y:AutomationProperties.Name="Entradas">
            <Border Classes="tab-pill" Classes.selected="{Binding IsSourcesTabSelected}">
              <TextBlock Text="Entradas" Classes="secondary" />
            </Border>
          </Button>
          <Button Grid.Column="2"
                  Classes="flat"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static models:StudioExplorerTabKind.Outputs}"
                  TabIndex="12"
                  a11y:AutomationProperties.AutomationId="project-explorer.tab.outputs"
                  a11y:AutomationProperties.Name="Saídas">
            <Border Classes="tab-pill" Classes.selected="{Binding IsOutputsTabSelected}">
              <TextBlock Text="Saídas" Classes="secondary" />
            </Border>
          </Button>
        </Grid>
        <TextBox Grid.Row="1"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 PlaceholderText="{Binding SearchPlaceholder}"
                 TabIndex="13"
                 a11y:AutomationProperties.AutomationId="project-explorer.search"
                 a11y:AutomationProperties.Name="{Binding SearchPlaceholder}" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding TabTitle}" Classes="panel-title" VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="primary"
                  ToolTip.Tip="{Binding AddButtonTip}"
                  Command="{Binding CurrentAddCommand}"
                  TabIndex="14"
                  a11y:AutomationProperties.AutomationId="project-explorer.add-current"
                  a11y:AutomationProperties.Name="{Binding AddButtonTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <components:StudioIcon Kind="{x:Static models:StudioIconKind.Add}" IconSize="13" />
              <TextBlock Text="{Binding AddButtonText}" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>

      <Grid Grid.Row="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsScenesTabSelected}">
          <ItemsControl ItemsSource="{Binding Scenes}" Margin="8,4,8,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SceneCardViewModel">
                <Button Command="{Binding SelectCommand}"
                        IsVisible="{Binding IsVisible}"
                        Padding="0"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        a11y:AutomationProperties.AutomationId="{Binding Id}"
                        a11y:AutomationProperties.Name="{Binding Name}"
                        a11y:AutomationProperties.HelpText="{Binding Detail}">
                  <Border Classes="scene-card"
                          Classes.selected="{Binding IsSelected}"
                          Classes.active="{Binding IsActive}"
                          HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                      <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                        <Border Classes="icon-box" Width="30" Height="30">
                          <components:StudioIcon Kind="{Binding IconKind}"
                                                 IconSize="16"
                                                 Foreground="{StaticResource MfAccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Badge}" Classes="accent" FontSize="11" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Metadata}" Classes="secondary" />
                      <TextBlock Grid.Row="2" Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsSourcesTabSelected}">
          <ItemsControl ItemsSource="{Binding Sources}" Margin="8,4,8,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceCardViewModel">
                <Button Command="{Binding SelectCommand}"
                        IsVisible="{Binding IsVisible}"
                        Padding="0"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        a11y:AutomationProperties.AutomationId="{Binding Id}"
                        a11y:AutomationProperties.Name="{Binding Name}"
                        a11y:AutomationProperties.HelpText="{Binding Metadata}">
                  <Border Classes="scene-card"
                          Classes.selected="{Binding IsSelected}"
                          HorizontalAlignment="Stretch">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                      <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                        <Border Classes="icon-box" Width="30" Height="30">
                          <components:StudioIcon Kind="{Binding IconKind}"
                                                 IconSize="16"
                                                 Foreground="{StaticResource MfAccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Badge}" Classes="accent" FontSize="11" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Metadata}" Classes="secondary" TextWrapping="Wrap" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsOutputsTabSelected}">
          <ItemsControl ItemsSource="{Binding Outputs}" Margin="8,4,8,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OutputCardViewModel">
                <Border Classes="scene-card"
                        Classes.selected="{Binding IsSelected}"
                        IsVisible="{Binding IsVisible}"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8">
                      <Border Classes="icon-box" Width="30" Height="30">
                        <components:StudioIcon Kind="{Binding IconKind}"
                                               IconSize="16"
                                               Foreground="{StaticResource MfAccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Badge}" Classes="accent" FontSize="11" />
                      </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding SceneName}" Classes="secondary" />
                    <TextBlock Grid.Row="2" Text="{Binding TransitionText}" Classes="muted" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                      <Button Content="{Binding RouteButtonText}"
                              Classes="primary"
                              Command="{Binding SendSceneCommand}"
                              a11y:AutomationProperties.AutomationId="{Binding Id}"
                              a11y:AutomationProperties.Name="{Binding RouteButtonText}"
                              a11y:AutomationProperties.HelpText="{Binding SceneName}" />
                      <Button Content="Configurar"
                              Command="{Binding ConfigureCommand}"
                              a11y:AutomationProperties.AutomationId="{Binding Id}"
                              a11y:AutomationProperties.Name="{Binding Name}"
                              a11y:AutomationProperties.HelpText="{Binding CodecText}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="Nada encontrado"
                   Classes="muted"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding CurrentTabHasNoResults}" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
