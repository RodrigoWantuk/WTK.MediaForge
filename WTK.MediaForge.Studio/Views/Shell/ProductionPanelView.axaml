<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             x:Class="WTK.MediaForge.Studio.Views.Shell.ProductionPanelView"
             x:DataType="vm:ProductionPanelViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Outputs}" Margin="8">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProductionOutputCardViewModel">
          <Border Classes="output-card" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="8">
                <Border Classes="icon-box" Width="32" Height="32">
                  <components:StudioIcon Kind="{Binding IconKind}"
                                         IconSize="17"
                                         Foreground="{StaticResource MfAccentBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Classes="badge"
                        VerticalAlignment="Center"
                        Background="{StaticResource MfSelectedBrush}">
                  <TextBlock Text="{Binding StatusText}" Classes="accent" FontSize="11" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="82,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Text="Cena atual" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding SceneName}" Classes="secondary" />
                <TextBlock Grid.Row="1" Text="Transição" Classes="muted" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TransitionText}" Classes="secondary" />
              </Grid>
              <Border Grid.Row="2" Classes="status-pill" HorizontalAlignment="Left">
                <TextBlock Text="Troca visual por seletor de cena" Classes="muted" FontSize="11" />
              </Border>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                <Button Content="Enviar cena"
                        Classes="primary"
                        Command="{Binding SendSceneCommand}" />
                <Button Content="Configurar"
                        Command="{Binding SelectCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
