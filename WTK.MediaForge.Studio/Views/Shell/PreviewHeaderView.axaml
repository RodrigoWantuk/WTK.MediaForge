<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:loc="using:WTK.MediaForge.Studio.Localization"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Shell.PreviewHeaderView"
             x:DataType="vm:PreviewCanvasViewModel">
  <Border Background="{StaticResource MfSurface1Brush}"
          BorderBrush="{StaticResource MfBorderBrush}"
          BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" Margin="12,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{Binding SceneName}" Classes="title" />
        <Border Classes="badge">
          <TextBlock Text="{Binding SceneRole}" Classes="accent" FontSize="11" />
        </Border>
        <Border Classes="badge" IsVisible="{Binding HasPendingChanges}" Background="{StaticResource MfWarningSoftBrush}">
          <TextBlock Text="{Binding DraftStateText}" Classes="warning" FontSize="11" />
        </Border>
        <TextBlock Text="{Binding CanvasSize}" Classes="secondary" />
        <TextBlock Text="{Binding FrameRate}" Classes="secondary" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Command="{Binding ApplySceneDraftCommand}"
                IsVisible="{Binding HasPendingChanges}"
                Classes="primary">
          <TextBlock Text="Aplicar na cena" />
        </Button>
        <Button Command="{Binding DiscardSceneDraftCommand}"
                IsVisible="{Binding HasPendingChanges}">
          <TextBlock Text="Descartar" />
        </Button>
        <Button Command="{Binding FitZoomCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <components:StudioIcon Kind="{x:Static models:StudioIconKind.Fit}" IconSize="13" />
            <TextBlock Text="{loc:Loc Preview_Fit}" />
          </StackPanel>
        </Button>
        <Button Content="{Binding ZoomLabel}" Command="{Binding ActualSizeCommand}" />
        <Button Command="{Binding ZoomOutCommand}" Padding="7">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.ZoomOut}" IconSize="14" />
        </Button>
        <Button Command="{Binding ZoomInCommand}" Padding="7">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.ZoomIn}" IconSize="14" />
        </Button>
        <Button Command="{Binding ToggleGridCommand}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <components:StudioIcon Kind="{x:Static models:StudioIconKind.Grid}" IconSize="13" />
            <TextBlock Text="{loc:Loc Preview_Grid}" />
          </StackPanel>
        </Button>
        <Button>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Ocultar"
                        Command="{Binding SetSafeAreaModeCommand}"
                        CommandParameter="hidden" />
              <MenuItem Header="Mostrar action safe"
                        Command="{Binding SetSafeAreaModeCommand}"
                        CommandParameter="action" />
              <MenuItem Header="Mostrar title safe"
                        Command="{Binding SetSafeAreaModeCommand}"
                        CommandParameter="title" />
              <MenuItem Header="{Binding SafeAreaProfileLabel}" IsEnabled="False" />
            </MenuFlyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <components:StudioIcon Kind="{x:Static models:StudioIconKind.SafeArea}" IconSize="13" />
            <TextBlock Text="{Binding SafeAreaModeLabel}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
