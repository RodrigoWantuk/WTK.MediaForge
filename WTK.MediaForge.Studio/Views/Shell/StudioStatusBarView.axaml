<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Shell.StudioStatusBarView"
             x:DataType="vm:StatusBarViewModel">
  <Border Background="{StaticResource MfSurface1Brush}"
          BorderBrush="{StaticResource MfBorderBrush}"
          BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="*,2*,Auto" Margin="10,0">
      <TextBlock Text="{Binding StatusText}"
                 Classes="secondary"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 Text="{Binding CenterText}"
                 Classes="muted"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
      <Border Grid.Column="2"
              Classes="badge"
              IsVisible="{Binding HasRightStatus}"
              VerticalAlignment="Center">
        <TextBlock Text="{Binding RightText}" Classes="accent" FontSize="11" />
      </Border>
    </Grid>
  </Border>
</UserControl>
