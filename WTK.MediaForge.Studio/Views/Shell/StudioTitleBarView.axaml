<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:loc="using:WTK.MediaForge.Studio.Localization"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Shell.StudioTitleBarView"
             x:DataType="vm:StudioShellViewModel">
  <Border Background="{StaticResource MfSurface1Brush}"
          BorderBrush="{StaticResource MfBorderBrush}"
          BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="*,Auto" Margin="10,0,0,0">
      <StackPanel Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center"
                  PointerPressed="OnTitleBarPointerPressed">
        <Border Width="22"
                Height="22"
                CornerRadius="5"
                Background="{StaticResource MfAccentSoftBrush}"
                BorderBrush="{StaticResource MfAccentBrush}"
                BorderThickness="1">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.Scene}"
                                 IconSize="14"
                                 Foreground="{StaticResource MfAccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding TitleBar.ProductName}" Classes="title" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TitleBar.ProjectName}" Classes="secondary" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Stretch">
        <Button Classes="window-control"
                Click="OnMinimizeClick"
                ToolTip.Tip="{loc:Loc Window_Minimize}">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.WindowMinimize}" IconSize="13" />
        </Button>
        <Button Classes="window-control"
                Click="OnMaximizeRestoreClick"
                ToolTip.Tip="{loc:Loc Window_MaximizeRestore}">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.WindowMaximize}" IconSize="13" />
        </Button>
        <Button Classes="window-control close"
                Click="OnCloseClick"
                ToolTip.Tip="{loc:Loc Window_Close}">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.WindowClose}" IconSize="13" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
