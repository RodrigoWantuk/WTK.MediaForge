<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:loc="using:WTK.MediaForge.Studio.Localization"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Shell.StudioTitleBarView"
             x:DataType="vm:StudioShellViewModel">
  <Border Background="{StaticResource MfSurface1Brush}"
          BorderBrush="{StaticResource MfBorderBrush}"
          BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Width="22"
                Height="22"
                CornerRadius="5"
                Background="{StaticResource MfAccentSoftBrush}"
                BorderBrush="{StaticResource MfAccentBrush}"
                BorderThickness="1">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.Scene}"
                                 IconSize="14"
                                 Foreground="{StaticResource MfAccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding TitleBar.ProductName}" Classes="title" VerticalAlignment="Center" />
        <TextBlock Text="{Binding TitleBar.ProjectName}" Classes="secondary" VerticalAlignment="Center" />
      </StackPanel>

      <Menu Grid.Column="1" Margin="18,0,0,0" Background="Transparent" VerticalAlignment="Center">
        <MenuItem Header="{loc:Loc Menu_File}">
          <MenuItem Header="Novo projeto" Command="{Binding NewProjectCommand}" />
          <MenuItem Header="Abrir projeto" Command="{Binding OpenProjectCommand}" />
          <MenuItem Header="Salvar" Command="{Binding SaveProjectCommand}" />
          <MenuItem Header="Salvar como" IsEnabled="False" />
          <Separator />
          <MenuItem Header="Sair" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="{loc:Loc Menu_Edit}">
          <MenuItem Header="Desfazer" IsEnabled="False" />
          <MenuItem Header="Refazer" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="{loc:Loc Menu_View}">
          <MenuItem Header="Diagnosticos avancados" IsEnabled="False" />
          <MenuItem Header="Metricas avancadas" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="{loc:Loc Menu_Scene}">
          <MenuItem Header="Adicionar cena" Command="{Binding AddSceneCommand}" />
          <MenuItem Header="Duplicar cena" IsEnabled="False" />
          <MenuItem Header="Excluir cena" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="{loc:Loc Menu_Source}">
          <MenuItem Header="Adicionar fonte" Command="{Binding AddSourceCommand}" />
          <MenuItem Header="Configurar fonte" IsEnabled="False" />
          <MenuItem Header="Remover fonte" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="{loc:Loc Menu_Output}">
          <MenuItem Header="Transmitir" Command="{Binding ToggleStreamingCommand}" />
          <MenuItem Header="Gravar" Command="{Binding ToggleRecordingCommand}" />
          <MenuItem Header="Configurar saidas" Command="{Binding ConfigureOutputCommand}" />
        </MenuItem>
        <MenuItem Header="{loc:Loc Menu_Tools}">
          <MenuItem Header="Configuracoes" Command="{Binding SettingsCommand}" />
        </MenuItem>
        <MenuItem Header="{loc:Loc Menu_Help}">
          <MenuItem Header="Documentacao" IsEnabled="False" />
          <MenuItem Header="Sobre" IsEnabled="False" />
        </MenuItem>
      </Menu>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Classes="badge">
          <TextBlock Text="{Binding Toolbar.StateBadge}" Classes="accent" FontSize="11" />
        </Border>
        <TextBlock Text="{Binding TitleBar.WorkspaceState}" Classes="secondary" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
