<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:controls="using:WTK.MediaForge.Studio.Views.Controls"
             x:Class="WTK.MediaForge.Studio.Views.Panels.PerformancePanelView"
             x:DataType="vm:BottomWorkbenchViewModel">
  <Grid Margin="12" ColumnDefinitions="360,*" ColumnSpacing="12">
    <ItemsControl ItemsSource="{Binding PerformanceMetrics}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PerformanceMetricViewModel">
          <Border Classes="metric-card" Width="160" Height="92" Margin="0,0,10,10">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" Classes="secondary" />
              <TextBlock Text="{Binding Value}" Classes="metric" />
              <TextBlock Text="{Binding Detail}" Classes="muted" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Grid.Column="1" Classes="metric-card">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Frame time history" Classes="panel-title" />
          <TextBlock Grid.Column="1" Text="last 120 frames" Classes="muted" />
        </Grid>
        <controls:SparklineControl Grid.Row="1"
                                   Stroke="{StaticResource MfAccentBrush}"
                                   StrokeThickness="2"
                                   Margin="0,14,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
