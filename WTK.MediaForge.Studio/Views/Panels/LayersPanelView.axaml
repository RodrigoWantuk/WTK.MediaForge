<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Panels.LayersPanelView"
             x:DataType="vm:BottomWorkbenchViewModel">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <Grid ColumnDefinitions="34,34,34,46,*,120,160,120" Margin="8,0,8,8">
      <TextBlock Text="" />
      <TextBlock Grid.Column="1" Text="" />
      <TextBlock Grid.Column="2" Text="" />
      <TextBlock Grid.Column="3" Text="#" Classes="muted" />
      <TextBlock Grid.Column="4" Text="Camada" Classes="muted" />
      <TextBlock Grid.Column="5" Text="Tipo" Classes="muted" />
      <TextBlock Grid.Column="6" Text="Fonte" Classes="muted" />
      <TextBlock Grid.Column="7" Text="Estado" Classes="muted" />
    </Grid>

    <ListBox Grid.Row="1"
             ItemsSource="{Binding Layers}"
             SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
             Background="Transparent"
             BorderThickness="0"
             Padding="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LayerItemViewModel">
            <Border Classes="layer-row" Classes.selected="{Binding IsSelected}" Margin="0,0,0,6">
              <Grid ColumnDefinitions="34,34,34,46,*,120,160,120" ColumnSpacing="4">
                <components:StudioIcon Kind="{x:Static models:StudioIconKind.Drag}" IconSize="16" Foreground="{StaticResource MfTextMutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="flat"
                        Command="{Binding ToggleVisibilityCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding VisibilityTip}">
                  <components:StudioIcon Kind="{Binding VisibilityIconKind}" IconSize="15" />
                </Button>
                <Button Grid.Column="2"
                        Classes="flat"
                        Command="{Binding ToggleLockCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding LockTip}">
                  <components:StudioIcon Kind="{Binding LockIconKind}" IconSize="15" />
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding Order}" Classes="secondary" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="icon-box" Width="28" Height="28">
                    <components:StudioIcon Kind="{Binding IconKind}" IconSize="16" Foreground="{StaticResource MfAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="{Binding Type}" Classes="secondary" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding Source}" Classes="secondary" VerticalAlignment="Center" />
                <Border Grid.Column="7" Classes="status-pill" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding VisibilityGlyph}" Classes="secondary" FontSize="11" />
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
