<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Panels.LayersPanelView"
             x:DataType="vm:BottomWorkbenchViewModel">
  <Grid RowDefinitions="Auto,*" Margin="12">
    <Grid ColumnDefinitions="48,*,160,110,76,76" Margin="8,0,8,8">
      <TextBlock Text="#" Classes="muted" />
      <TextBlock Grid.Column="1" Text="Layer" Classes="muted" />
      <TextBlock Grid.Column="2" Text="Source" Classes="muted" />
      <TextBlock Grid.Column="3" Text="Type" Classes="muted" />
      <TextBlock Grid.Column="4" Text="Visible" Classes="muted" />
      <TextBlock Grid.Column="5" Text="Lock" Classes="muted" />
    </Grid>

    <ListBox Grid.Row="1"
             ItemsSource="{Binding Layers}"
             SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
             Background="Transparent"
             BorderThickness="0"
             Padding="0">
      <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LayerItemViewModel">
            <Border Classes="layer-row" Classes.selected="{Binding IsSelected}" Margin="0,0,0,6">
              <Grid ColumnDefinitions="48,*,160,110,76,76">
                <TextBlock Text="{Binding Order}" Classes="secondary" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Width="24" Height="24" CornerRadius="5" Background="{StaticResource MfSurface3Brush}">
                    <TextBlock Text="{Binding Icon}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="secondary" />
                  </Border>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="secondary" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Type}" Classes="secondary" VerticalAlignment="Center" />
                <Button Grid.Column="4"
                        Content="{Binding VisibilityGlyph}"
                        Command="{Binding ToggleVisibilityCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding VisibilityTip}"
                        Classes="flat" />
                <Button Grid.Column="5"
                        Content="{Binding LockGlyph}"
                        Command="{Binding ToggleLockCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding LockTip}"
                        Classes="flat" />
              </Grid>
            </Border>
          </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
