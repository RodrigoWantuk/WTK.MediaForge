<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Panels.EffectsPanelView"
             x:DataType="vm:BottomWorkbenchViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Effects}" Margin="12">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:EffectItemViewModel">
          <Border Classes="metric-card" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Name}" Classes="title" />
              <Button Grid.Column="1" Content="{Binding EnabledText}" Command="{Binding ToggleEnabledCommand}" CommandParameter="{Binding}" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Classes="secondary" TextWrapping="Wrap" Margin="0,6,0,0" />
              <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,12,0,0" IsVisible="{Binding IsExpanded}">
                <TextBox Text="Tolerance 0.32" IsReadOnly="True" />
                <TextBox Grid.Column="1" Text="Spill 0.18" IsReadOnly="True" />
                <TextBox Grid.Column="2" Text="Edge 0.24" IsReadOnly="True" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
