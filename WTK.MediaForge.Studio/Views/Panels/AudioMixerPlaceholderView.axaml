<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Panels.AudioMixerPlaceholderView"
             x:DataType="vm:BottomWorkbenchViewModel">
  <Grid Margin="12" RowDefinitions="Auto,*">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Audio Mixer" Classes="title" />
      <Border Classes="badge">
        <TextBlock Text="BETA" Classes="warning" />
      </Border>
      <TextBlock Text="Future-only visual placeholder. No audio capture, mix, mux, or equalization is active." Classes="secondary" VerticalAlignment="Center" />
    </StackPanel>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding AudioStrips}" Margin="0,12,0,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="10" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AudioStripViewModel">
          <Border Classes="metric-card" Width="132" Height="172">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <components:StudioIcon Kind="{x:Static models:StudioIconKind.Audio}" IconSize="15" Foreground="{StaticResource MfAccentBrush}" />
                <TextBlock Text="{Binding Name}" Classes="secondary" />
              </StackPanel>
              <Border Grid.Row="1" Width="18" HorizontalAlignment="Center" Margin="0,4" Background="{StaticResource MfSurface3Brush}" CornerRadius="4">
                <Border Height="74" VerticalAlignment="Bottom" Background="{StaticResource MfAccentBrush}" CornerRadius="4" />
              </Border>
              <StackPanel Grid.Row="2" Spacing="2">
                <TextBlock Text="{Binding Peak}" HorizontalAlignment="Center" Classes="mono secondary" />
                <TextBlock Text="{Binding MuteText}" HorizontalAlignment="Center" Classes="muted" />
              </StackPanel>
              <Slider Grid.Row="3" Minimum="0" Maximum="1" Value="0.68" IsEnabled="False" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
