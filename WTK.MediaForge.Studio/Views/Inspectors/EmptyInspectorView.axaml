<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.EmptyInspectorView"
             x:DataType="vm:EmptyInspectorViewModel">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="{Binding Title}" Classes="title" />
    <TextBlock Text="{Binding Subtitle}" Classes="secondary" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
