<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.OutputInspectorView"
             x:DataType="vm:OutputInspectorViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Classes="icon-box" Width="40" Height="40">
          <components:StudioIcon Kind="{Binding IconKind}"
                                 IconSize="22"
                                 Foreground="{StaticResource MfAccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="Propriedades da saída" Classes="panel-title" />
          <TextBlock Text="{Binding Title}" Classes="title" />
          <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
        </StackPanel>
      </Grid>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="ROTEAMENTO" Classes="panel-title" />
          <Border Classes="metric-card">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
              <TextBlock Text="{Binding CurrentSceneName, StringFormat='Cena atual: {0}'}" FontWeight="SemiBold" />
              <Button Grid.Column="1" Content="Enviar outra cena" Command="{Binding SendSceneCommand}" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                         Text="A troca de cena acontece pelo fluxo explícito de envio para saída."
                         Classes="secondary"
                         TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock Text="Transição padrão" Classes="muted" />
              <ComboBox ItemsSource="{Binding TransitionOptions}"
                        SelectedValue="{Binding SelectedTransitionId, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Id}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TransitionOptionViewModel">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Duração" Classes="muted" />
              <NumericUpDown Value="{Binding TransitionDurationMs, Mode=TwoWay}" Minimum="0" Maximum="5000" Increment="50" />
            </StackPanel>
          </Grid>
          <CheckBox Content="Saída habilitada" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
          <CheckBox Content="Configurada" IsChecked="{Binding IsConfigured, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="DESTINO" Classes="panel-title" />
          <StackPanel Spacing="4">
            <TextBlock Text="Tipo" Classes="muted" />
            <ComboBox ItemsSource="{Binding OutputTypes}" SelectedItem="{Binding SelectedOutputType, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Servidor ou caminho" Classes="muted" />
            <TextBox Text="{Binding Destination}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Chave/segredo" Classes="muted" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding MaskedStreamKey}" Classes="mono" IsReadOnly="True" />
              <Button Grid.Column="1" Classes="flat" IsEnabled="False">
                <components:StudioIcon Kind="{x:Static models:StudioIconKind.Eye}" IconSize="14" />
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="QUALIDADE" Classes="panel-title" />
          <StackPanel Spacing="4">
            <TextBlock Text="Codec" Classes="muted" />
            <ComboBox ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Bitrate" Classes="muted" />
            <TextBox Text="{Binding Bitrate}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Preset" Classes="muted" />
            <ComboBox ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
