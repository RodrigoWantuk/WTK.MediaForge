<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.OutputInspectorView"
             x:DataType="vm:OutputInspectorViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Classes="icon-box" Width="40" Height="40">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.Output}"
                                 IconSize="22"
                                 Foreground="{StaticResource MfAccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding Title}" Classes="title" />
          <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
        </StackPanel>
      </Grid>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="ROTA" Classes="panel-title" />
          <StackPanel Spacing="4">
            <TextBlock Text="Cena enviada para esta saida" Classes="muted" />
            <ComboBox ItemsSource="{Binding Scenes}"
                      SelectedItem="{Binding SelectedScene, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SceneRouteOptionViewModel">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <CheckBox Content="Saida habilitada" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
          <CheckBox Content="Configurada" IsChecked="{Binding IsConfigured, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="DESTINO" Classes="panel-title" />
          <StackPanel Spacing="4">
            <TextBlock Text="Tipo" Classes="muted" />
            <ComboBox ItemsSource="{Binding OutputTypes}" SelectedItem="{Binding SelectedOutputType, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Servidor ou caminho" Classes="muted" />
            <TextBox Text="{Binding Destination}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Chave/segredo" Classes="muted" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding MaskedStreamKey}" Classes="mono" IsReadOnly="True" />
              <Button Grid.Column="1" Classes="flat" IsEnabled="False">
                <components:StudioIcon Kind="{x:Static models:StudioIconKind.Eye}" IconSize="14" />
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="PERFIL" Classes="panel-title" />
          <StackPanel Spacing="4">
            <TextBlock Text="Codec" Classes="muted" />
            <ComboBox ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding SelectedCodec, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Bitrate" Classes="muted" />
            <TextBox Text="{Binding Bitrate}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Preset" Classes="muted" />
            <ComboBox ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="8">
          <TextBlock Text="ESTADO" Classes="panel-title" />
          <Border Classes="metric-card">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Classes="health-dot" Classes.healthy="True" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Health}" Classes="success" />
                <TextBlock Text="{Binding SelectedSceneName, StringFormat='Cena atual: {0}'}" Classes="secondary" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
