<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.OutputInspectorView"
             x:DataType="vm:OutputInspectorViewModel">
  <StackPanel Margin="14" Spacing="14">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding Title}" Classes="title" />
      <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
    </StackPanel>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Text="{Binding Destination, StringFormat='Destination: {0}'}" Classes="secondary" TextWrapping="Wrap" />
      <TextBlock Grid.Row="1" Text="{Binding Codec, StringFormat='Codec: {0}'}" Classes="secondary" />
      <TextBlock Grid.Row="2" Text="{Binding Bitrate, StringFormat='Bitrate: {0}'}" Classes="secondary" />
      <TextBlock Grid.Row="3" Text="{Binding Health, StringFormat='Health: {0}'}" Classes="success" />
      <TextBlock Grid.Row="4" Text="{Binding MaskedStreamKey, StringFormat='Stream key: {0}'}" Classes="mono" />
    </Grid>
  </StackPanel>
</UserControl>
