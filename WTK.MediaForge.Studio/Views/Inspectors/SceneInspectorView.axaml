<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.SceneInspectorView"
             x:DataType="vm:SceneInspectorViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Title}" Classes="title" />
        <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
      </StackPanel>

      <Border Classes="section">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Text="CANVAS" Classes="panel-title" />
          <TextBlock Grid.Row="1" Text="{Binding CanvasSize, StringFormat='Tamanho: {0}'}" Classes="secondary" />
          <TextBlock Grid.Row="2" Text="{Binding AspectRatio, StringFormat='Proporcao: {0}'}" Classes="secondary" />
          <TextBlock Grid.Row="3" Text="{Binding FrameRateText, StringFormat='FPS: {0}'}" Classes="secondary" />
          <TextBlock Grid.Row="4" Text="{Binding BackgroundColor, StringFormat='Fundo: {0}'}" Classes="secondary" />
          <TextBlock Grid.Row="5" Text="{Binding LayerCount, StringFormat='Camadas: {0}'}" Classes="secondary" />
        </Grid>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="8">
          <TextBlock Text="ROTAS" Classes="panel-title" />
          <TextBlock Text="{Binding LinkedOutputs}" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
