<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.SourceInspectorView"
             x:DataType="vm:SourceInspectorViewModel">
  <StackPanel Margin="14" Spacing="14">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding Title}" Classes="title" />
      <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
    </StackPanel>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Text="{Binding SourceType, StringFormat='Type: {0}'}" Classes="secondary" />
      <TextBlock Grid.Row="1" Text="{Binding Endpoint, StringFormat='Endpoint: {0}'}" Classes="secondary" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Text="{Binding ResolutionText, StringFormat='Resolution: {0}'}" Classes="secondary" />
      <TextBlock Grid.Row="3" Text="{Binding FrameRateText, StringFormat='Frame rate: {0}'}" Classes="secondary" />
      <TextBlock Grid.Row="4" Text="{Binding Status, StringFormat='Status: {0}'}" Classes="success" />
    </Grid>

    <Button Content="Reconnect" Command="{Binding ReconnectCommand}" Classes="primary" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
