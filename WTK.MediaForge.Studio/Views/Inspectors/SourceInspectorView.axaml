<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.SourceInspectorView"
             x:DataType="vm:SourceInspectorViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Classes="icon-box" Width="38" Height="38">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.Source}"
                                 IconSize="22"
                                 Foreground="{StaticResource MfAccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding Title}" Classes="title" />
          <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
        </StackPanel>
      </Grid>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="DEVICE" Classes="panel-title" />
          <StackPanel Spacing="4">
            <TextBlock Text="Type" Classes="muted" />
            <ComboBox ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Resolution" Classes="muted" />
            <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Frame rate" Classes="muted" />
            <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="8">
          <TextBlock Text="STATUS" Classes="panel-title" />
          <Border Classes="metric-card">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Classes="health-dot" Classes.healthy="True" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Status, StringFormat='Healthy / {0}'}" Classes="success" />
                <TextBlock Text="{Binding FrameRateText, StringFormat='Streaming {0} - buffer 2 frames - 0 dropped'}" Classes="secondary" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="8">
          <TextBlock Text="ACTIONS" Classes="panel-title" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Reconnect" Command="{Binding ReconnectCommand}" Classes="primary" />
            <Button Content="Configure device" IsEnabled="False" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Expander Header="Advanced details">
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <TextBlock Text="{Binding SourceType, StringFormat='Type: {0}'}" Classes="mono muted" />
          <TextBlock Text="{Binding Endpoint, StringFormat='Endpoint: {0}'}" Classes="mono muted" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
