<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTK.MediaForge.Studio.ViewModels"
             xmlns:components="using:WTK.MediaForge.Studio.Views.Components"
             xmlns:models="using:WTK.MediaForge.Studio.Models"
             x:Class="WTK.MediaForge.Studio.Views.Inspectors.SourceInspectorView"
             x:DataType="vm:SourceInspectorViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Border Classes="icon-box" Width="40" Height="40">
          <components:StudioIcon Kind="{x:Static models:StudioIconKind.Source}"
                                 IconSize="22"
                                 Foreground="{StaticResource MfAccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding Title}" Classes="title" />
          <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
        </StackPanel>
      </Grid>

      <Border Classes="section">
        <StackPanel Spacing="10">
          <TextBlock Text="FONTE" Classes="panel-title" />
          <StackPanel Spacing="4">
            <TextBlock Text="Dispositivo ou origem" Classes="muted" />
            <ComboBox ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Resolução" Classes="muted" />
            <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="FPS" Classes="muted" />
            <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="8">
          <TextBlock Text="ESTADO" Classes="panel-title" />
          <Border Classes="metric-card">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Border Classes="health-dot" Classes.healthy="True" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Status}" Classes="success" />
                <TextBlock Text="{Binding FrameRateText, StringFormat='Visual {0} - captura real ainda não conectada'}" Classes="secondary" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="section">
        <StackPanel Spacing="8">
          <TextBlock Text="AÇÕES" Classes="panel-title" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Adicionar à cena atual" Command="{Binding AddToSceneCommand}" Classes="primary" />
            <Button Content="Reconectar" Command="{Binding ReconnectCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding CurrentSceneName, StringFormat='Destino: {0}'}"
                     Classes="secondary" />
        </StackPanel>
      </Border>

      <Expander Header="Detalhes avançados">
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <TextBlock Text="{Binding SourceType, StringFormat='Tipo: {0}'}" Classes="mono muted" />
          <TextBlock Text="{Binding Endpoint, StringFormat='Origem: {0}'}" Classes="mono muted" TextWrapping="Wrap" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
