<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MfTextPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource MfSurface2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="11,6" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource MfAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfAccentBrush}" />
    <Setter Property="Foreground" Value="#03101A" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource MfRecordBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfRecordBrush}" />
  </Style>

  <Style Selector="Button.warning">
    <Setter Property="Background" Value="{StaticResource MfWarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfWarningBrush}" />
  </Style>

  <Style Selector="Button.live">
    <Setter Property="Background" Value="{StaticResource MfAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MfTextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.production">
    <Setter Property="Background" Value="{StaticResource MfInputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderNormalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MfTextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.production.live">
    <Setter Property="Background" Value="{StaticResource MfAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfAccentHoverBrush}" />
    <Setter Property="Foreground" Value="#03101A" />
  </Style>

  <Style Selector="Button.production.recording">
    <Setter Property="Background" Value="{StaticResource MfRecordBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfRecordBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MfTextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.production.busy">
    <Setter Property="Background" Value="{StaticResource MfSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfAccentBrush}" />
  </Style>

  <Style Selector="Button.window-control">
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="35" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.window-control:pointerover">
    <Setter Property="Background" Value="{StaticResource MfSurface3Brush}" />
  </Style>

  <Style Selector="Button.window-control.close:pointerover">
    <Setter Property="Background" Value="{StaticResource MfErrorBrush}" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderStrongBrush}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource MfSurface1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.project-row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Background" Value="{StaticResource MfCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.project-row.selected">
    <Setter Property="Background" Value="{StaticResource MfAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.project-row.active">
    <Setter Property="BorderBrush" Value="{StaticResource MfSuccessBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.layer-row">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{StaticResource MfCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.layer-row.selected">
    <Setter Property="Background" Value="{StaticResource MfAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfAccentBrush}" />
  </Style>

  <Style Selector="Border.tab-pill">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.tab-pill.selected">
    <Setter Property="Background" Value="{StaticResource MfSurface3Brush}" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="{StaticResource MfSurface3Brush}" />
  </Style>

  <Style Selector="Border.health-dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource MfTextMutedBrush}" />
  </Style>

  <Style Selector="Border.health-dot.healthy">
    <Setter Property="Background" Value="{StaticResource MfSuccessBrush}" />
  </Style>

  <Style Selector="Border.health-dot.warning">
    <Setter Property="Background" Value="{StaticResource MfWarningBrush}" />
  </Style>

  <Style Selector="Border.health-dot.error">
    <Setter Property="Background" Value="{StaticResource MfErrorBrush}" />
  </Style>

  <Style Selector="Border.health-dot.planned">
    <Setter Property="Background" Value="{StaticResource MfTextMutedBrush}" />
  </Style>

  <Style Selector="Border.health-dot.disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Border.metric-card">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="{StaticResource MfSurface2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.dialog-card">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Background" Value="{StaticResource MfSurface1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource MfInputBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MfTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderNormalBrush}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{StaticResource MfInputBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MfTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderNormalBrush}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource MfInputBrush}" />
    <Setter Property="Foreground" Value="{StaticResource MfTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource MfBorderNormalBrush}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{StaticResource MfAccentBrush}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
